# Call Leads Website Configuration
NEXT_PUBLIC_SITE_URL=https://getcalllead.io
NEXT_PUBLIC_APP_NAME="Call Leads"
NEXT_PUBLIC_SUPPORT_EMAIL=support@getcalllead.io

# Enable a platform only after the exact public listing returns HTTP 200.
NEXT_PUBLIC_ANDROID_STORE_ENABLED=false
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_IOS_STORE_ENABLED=false
NEXT_PUBLIC_APP_STORE_URL=

# Legal identity and public company information used in policies/contact pages.
NEXT_PUBLIC_LEGAL_NAME=Invention Hill
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Durable public lead and account-deletion workflows.
BACKEND_API_URL=https://api.getcalllead.io
WEBSITE_KEY_ID=website-v1
WEBSITE_HMAC_SECRET=replace-with-at-least-32-random-characters
IP_RATE_LIMIT_SECRET=replace-with-a-different-32-character-secret
TRUSTED_PROXY_HEADER_SECRET=replace-with-the-32-character-proxy-shared-secret
